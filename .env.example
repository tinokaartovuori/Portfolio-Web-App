# The site's own origin, for canonical URLs, og:image and JSON-LD
NUXT_PUBLIC_SITE_URL=https://tino.kaartovuori.fi
# Unlocks /api/stats?key=…; make it long and random (openssl rand -hex 32)
NUXT_STATS_KEY=
# The hostnames (tino.kaartovuori.fi, the redirects from kaartovuori.fi and
# www, stats.kaartovuori.fi) are the Droplet's Caddy's business: see
# docker/Caddyfile in tmi-tino-kaartovuori-kirjanpito.
