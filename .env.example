# The canonical host; Caddy gets its certificate for it
DOMAIN=tino.kaartovuori.fi
# The site's own origin, for canonical URLs, og:image and JSON-LD
NUXT_PUBLIC_SITE_URL=https://tino.kaartovuori.fi
# Other hosts that should 301 to the canonical one, space-separated. Leave
# empty to redirect nothing (the redirect block then matches nothing).
REDIRECT_DOMAINS=kaartovuori.fi www.kaartovuori.fi
# Unlocks /api/stats?key=…; make it long and random
NUXT_STATS_KEY=
